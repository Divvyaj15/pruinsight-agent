# Copy this file to `.env` and fill in values.
# Never commit your real `.env`.

# --- Required ---
GROQ_API_KEY=gsk_your_groq_key

# --- Search (at least one path: Tavily preferred, or Serper, or free DuckDuckGo via ddgs) ---
TAVILY_API_KEY=tvly_your_tavily_key
# SERPER_API_KEY=your_serper_key

# --- Optional macro ---
# FRED_API_KEY=your_fred_key

# --- LangSmith observability + Studio (recommended) ---
# 1. Sign up: https://smith.langchain.com
# 2. Create API key in Settings → paste below
# 3. Traces: run CLI/Streamlit → project "pruinsight-agent"
# 4. Studio IDE: see LANGSMITH_STUDIO_SETUP.md
#    pip install "langgraph-cli[inmem]" && pip install -e . && langgraph dev
#
# Tracing turns ON automatically when LANGSMITH_API_KEY is set.
# Set LANGSMITH_TRACING=false to force off.
#
LANGSMITH_API_KEY=lsv2_your_langsmith_key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=pruinsight-agent
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Legacy aliases (optional — also supported):
# LANGCHAIN_API_KEY=...
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_PROJECT=pruinsight-agent
